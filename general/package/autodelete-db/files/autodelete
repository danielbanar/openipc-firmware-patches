#!/bin/sh

# Usage: autodelete <device> <directory-to-clean> <high%> <low%> <interval>
# Example: autodelete /dev/mmcblk0p1 /mnt/mmcblk0p1 95 90 300

DEVICE="$1"
DIR="$2"
THRESHOLD_HIGH="$3"
THRESHOLD_LOW="$4"
INTERVAL="$5"

if [ -z "$DEVICE" ] || [ -z "$DIR" ] || [ -z "$THRESHOLD_HIGH" ] || [ -z "$THRESHOLD_LOW" ] || [ -z "$INTERVAL" ]; then
    echo "Usage: $0 <device> <directory-to-clean> <high%> <low%> <interval-seconds>"
    exit 1
fi

while true; do
    USAGE=$(df -h "$DEVICE" | awk 'NR==2 {gsub("%","",$5); print $5}')

    if [ "$USAGE" -gt "$THRESHOLD_HIGH" ]; then
        echo "$(date) - Usage $USAGE% exceeds $THRESHOLD_HIGH%. Cleaning up in $DIR..."

        while [ "$USAGE" -gt "$THRESHOLD_LOW" ]; do
            # Find the oldest file recursively
            OLDEST_FILE=$(find "$DIR" -type f -exec stat -c '%Y %n' {} \; 2>/dev/null | sort -n | head -n 1 | cut -d' ' -f2-)

            if [ -z "$OLDEST_FILE" ]; then
                echo "No files left to delete in $DIR"
                break
            fi

            echo "Deleting $OLDEST_FILE ..."
            rm -f "$OLDEST_FILE"

            # Check if parent directory is empty and remove it
            PARENT_DIR=$(dirname "$OLDEST_FILE")
            if [ "$(ls -A "$PARENT_DIR")" = "" ]; then
                echo "Directory $PARENT_DIR is empty, removing it ..."
                rmdir "$PARENT_DIR"
            fi

            # Recalculate usage
            USAGE=$(df -h "$DEVICE" | awk 'NR==2 {gsub("%","",$5); print $5}')
        done

        echo "$(date) - Cleanup done. Usage is now ${USAGE}%"
    fi

    sleep "$INTERVAL"
done
