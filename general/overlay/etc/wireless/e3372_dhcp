#!/bin/sh

DEV="/dev/ttyUSB1"   # AT port of the modem
BAUD="115200"

# Check for device
if [ ! -e "$DEV" ]; then
    echo "Error: Device $DEV not found!"
    exit 1
fi

# Configure serial
stty -F "$DEV" $BAUD raw -echo || true

# DHCP print command
echo -e "AT+CGCONTRDP\r" > "$DEV"

sleep 1

RESP=$(timeout 3 cat "$DEV")

echo "Raw response:"
echo "$RESP"

# Parse
LINE=$(echo "$RESP" | grep -F "+CGCONTRDP")

if [ -z "$LINE" ]; then
    echo "No CGCONTRDP response found"
    exit 1
fi

IPMASK=$(echo "$LINE" | cut -d'"' -f4)
IP=$(echo "$IPMASK" | cut -d'.' -f1-4)
MASK=$(echo "$IPMASK" | cut -d'.' -f5-8)
GW=$(echo "$LINE" | cut -d'"' -f6)
DNS1=$(echo "$LINE" | cut -d'"' -f8)
DNS2=$(echo "$LINE" | cut -d'"' -f10)

echo "Parsed values:"
echo "IP:      $IP"
echo "Mask:    $MASK"
echo "Gateway: $GW"
echo "DNS1:    $DNS1"
echo "DNS2:    $DNS2"

mask_to_cidr() {
    MASK=$1
    IFS=. read i1 i2 i3 i4 <<EOF
$MASK
EOF

    CIDR=0
    for i in $i1 $i2 $i3 $i4; do
        b=$(echo "obase=2; $i" | bc)
        ones=$(echo "$b" | tr -cd 1 | wc -c)
        CIDR=$((CIDR + ones))
    done
    echo $CIDR
}

CIDR=$(mask_to_cidr $MASK)
echo "CIDR: /$CIDR"

# Configure wwan0 manually
ip link set wwan0 up
ip addr flush dev wwan0
ip addr add $IP/$CIDR dev wwan0
ip route add default via $GW dev wwan0

if [ -n "$DNS1" ]; then
    echo "nameserver $DNS1" > /etc/resolv.conf
fi
if [ -n "$DNS2" ]; then
    echo "nameserver $DNS2" >> /etc/resolv.conf
fi
